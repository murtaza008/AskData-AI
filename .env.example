# ─────────────────────────────────────────────────────────────────────────────
# AskData AI — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Owner connection string from the Neon dashboard. Used by Prisma for app data
# (users, conversations, pinned charts), by migrations, and by the seed/setup
# scripts. Use the *pooled* host (contains "-pooler") for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection, used only by `prisma migrate` and the setup
# scripts. Same string as above without "-pooler" in the host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Read-only connection the AI agent uses to run analytics queries.
# `npm run db:setup` creates the `askdata_readonly` role and prints this value.
ANALYTICS_DATABASE_URL="postgresql://askdata_readonly:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Password given to the read-only role when `npm run db:setup` creates it.
# Generate one with: openssl rand -hex 24
ANALYTICS_ROLE_PASSWORD=""

# ── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Only needed in production behind a proxy / custom domain.
# AUTH_URL="https://your-app.vercel.app"

# ── AI providers ────────────────────────────────────────────────────────────
# Which provider the agent uses by default: google | openai | anthropic
AI_PROVIDER="google"

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional. A provider only appears in the model picker when its key is set.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Agent limits (optional overrides) ───────────────────────────────────────
# Max rows returned by a single analytics query.
QUERY_ROW_LIMIT="500"
# Postgres statement_timeout for analytics queries, in milliseconds.
QUERY_TIMEOUT_MS="5000"
# Max CSV upload size in megabytes. Keep it at 4 or below on Vercel, whose
# serverless functions reject request bodies larger than 4.5 MB.
UPLOAD_MAX_MB="4"
# Uploaded tables older than this many days are deleted.
UPLOAD_TTL_DAYS="7"

# Questions per 24h allowed for the shared public demo account.
DEMO_DAILY_QUESTIONS="150"

# Secret that protects the upload clean-up cron endpoint (Vercel Cron sends it).
CRON_SECRET=""
